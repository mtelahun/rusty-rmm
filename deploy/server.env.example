# Copy to /etc/rustyrmm/server.env (owner rustyrmm, mode 0600).
# The Server reads DATABASE_URL; the unit reads RUSTYRMM_HOSTNAME.
DATABASE_URL=postgres://rustyrmm:CHANGE_ME@localhost/rustyrmm
RUSTYRMM_HOSTNAME=rmm.example.com

# Email Notifications (optional; see doc/deploy.md). Email is on when HOST and FROM are set,
# and then RUSTYRMM_PUBLIC_URL is required.
#RUSTYRMM_SMTP_HOST=smtp.example.com
#RUSTYRMM_SMTP_PORT=587
#RUSTYRMM_SMTP_TLS=starttls
#RUSTYRMM_SMTP_USERNAME=rustyrmm
#RUSTYRMM_SMTP_PASSWORD=CHANGE_ME
#RUSTYRMM_SMTP_FROM=RustyRMM <rmm@example.com>
#RUSTYRMM_PUBLIC_URL=https://rmm.example.com
